{
  "name": "particle-life-3d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "3D particle-life: instanced WebGL2 particles, orbit camera, stats HUD (M0 scaffold).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "esbuild scripts/sim-smoke.mts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-sim-smoke.mjs --log-level=warning && node node_modules/.tmp-sim-smoke.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.19.2"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
